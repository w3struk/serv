{
    auto_https disable_redirects

    servers {
        trusted_proxies static 127.0.0.1/32
    }
}

# The panel derives the client address from X-Forwarded-For and no longer
# trusts a client-supplied X-Real-IP (3x-ui v3.11.0+). Strip it so a spoofed
# header cannot turn the login limiter into the proxy address.
(strip_real_ip) {
    header_up -X-Real-IP
}

http://:80 {
    bind 0.0.0.0
    redir https://$DOMAIN{uri} permanent
}

$DOMAIN {
    encode gzip zstd

    handle /$ADMIN_PATH/panel/api/* {
        reverse_proxy 127.0.0.1:2053 {
            import strip_real_ip
        }
    }

    handle /$ADMIN_PATH/* {
        basic_auth {
            admin $WEB_PASSWORD_HASH
        }
        reverse_proxy 127.0.0.1:2053 {
            import strip_real_ip
        }
    }

    handle /assets/* {
        rewrite * /$ADMIN_PATH{path}
        reverse_proxy 127.0.0.1:2053 {
            import strip_real_ip
        }
    }

    handle /$SUB_PATH/* {
        reverse_proxy 127.0.0.1:2096
    }

    handle /$JSON_PATH/* {
        reverse_proxy 127.0.0.1:2096
    }

    handle /$CLASH_PATH/* {
        reverse_proxy 127.0.0.1:2096
    }

    handle /$XHTTP_PATH/* {
        reverse_proxy unix/@uds_xhttp {
            header_up -X-Forwarded-For
            flush_interval -1
            transport http {
                versions h2c 2
                proxy_protocol v2
            }
        }
    }

    handle /adminpanel* {
        basic_auth {
            admin $WEB_PASSWORD_HASH
        }
        reverse_proxy 127.0.0.1:9118
    }

    handle {
        reverse_proxy 127.0.0.1:9118
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        -Server
        -X-Powered-By
    }
}
